.DS_Store
_build/
.mooncakes/
.moonagent/

# Coverage files
*.coverage
_coverage/

# APM dependencies
apm_modules/
.agents/
.claude/

# moonup toolchain pin (local experimentation only; do not force nightly on other clones)
moonbit-version

# moon build trace output
trace.json

# Xcode / Swift (see also github/gitignore Xcode.gitignore, Swift.gitignore)
ios/**/xcuserdata/
ios/**/*.hmap
ios/**/*.dSYM
ios/**/*.dSYM.zip

# Tuist-generated Xcode project/workspace and build artifacts (run `tuist generate` to recreate)
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/Derived/
ios/Tuist/.build/

# guest.wasm is a moon build artifact, not source; copy it from
# _build/wasm/release/build/exp_mbt_wasmkit_ios_guest.wasm before building the iOS app
ios/Resources/*.wasm
